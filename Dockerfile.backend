FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/backend/package.json ./packages/backend/

RUN npm ci

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/backend ./packages/backend

RUN npm run build -w packages/shared
RUN cd packages/backend && npx tsc --noEmit
RUN npm run build -w packages/backend

FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl

ENV NODE_ENV=production

RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

COPY --from=builder /app/packages/backend/dist ./dist
COPY --from=builder /app/packages/backend/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared/dist ./node_modules/@healthcare/shared/dist
COPY --from=builder /app/packages/shared/package.json ./node_modules/@healthcare/shared/package.json

# Source, migrations and seeds so the same migrate/seed scripts used in CI can
# run inside the container (npm run migrate / npm run seed equivalents).
COPY --from=builder /app/packages/backend/src ./src
COPY --from=builder /app/packages/backend/migrations ./migrations
COPY --from=builder /app/packages/backend/seeds ./seeds

RUN mkdir -p /app/uploads && chown -R appuser:appgroup /app

USER appuser

EXPOSE 3000

# TS migrations require the tsx loader, so apply them before starting the API
# (mirrors railway.json: `npm run migrate && node dist/index.js`).
CMD ["sh", "-c", "npx --no-install tsx src/core/migrate.ts && node dist/index.js"]

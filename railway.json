{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev --no-audit --no-fund && npm run build -w packages/shared && npm run build -w packages/backend"
  },
  "deploy": {
    "startCommand": "node -e \"const http=require('http');const s=http.createServer((q,r)=>{r.writeHead(200,{'content-type':'text/plain'});r.end('probe-plain-ok '+new Date().toISOString())});s.listen(3000,'::',()=>console.log('PROBE_LISTENING ::3000'))\"",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

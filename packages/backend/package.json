{
  "name": "@healthcare/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/run-postgres-integration.ts authorization",
    "test:billing-integration": "tsx scripts/run-postgres-integration.ts billing",
    "test:rls-integration": "tsx scripts/run-postgres-integration.ts rls",
    "test:watch": "vitest",
    "migrate": "npx tsx src/core/migrate.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts",
    "seed": "tsx src/core/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.0",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.2.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.6",
    "slugify": "^1.6.6",
    "tsx": "^4.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}

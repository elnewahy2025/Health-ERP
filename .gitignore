# Dependencies
node_modules/

# Build output
packages/backend/dist/
packages/frontend/dist/
packages/shared/dist/
# TypeScript incremental build cache (machine/build-state, not source)
*.tsbuildinfo

# Environment files
.env
.env.local
.env.production
.env.docker
.env.*.local
*.bak
*.backup

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Database backups
/backups/

# Docker volumes
postgres_data/
redis_data/
minio_data/
es_data/

# Certificates
deployment/nginx/ssl/*.pem
deployment/nginx/ssl/*.key

# Generated icons
packages/frontend/public/icons/icon-192.png
packages/frontend/public/icons/icon-512.png
packages/frontend/public/icons/generate-icons.mjs
.github/workflows/sbom.yml

# SSL certificates (never commit real certs)
deployment/nginx/ssl/*.pem
deployment/nginx/ssl/*.key
deployment/nginx/ssl/*.crt

# Allow Dockerfile.backup
!Dockerfile.backup
secrets/
!.gitignore
.vercel

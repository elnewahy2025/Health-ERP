# ============================================
# Health-ERP Clinic Management System - Docker Environment Template
# ============================================
# The local Docker stack reads a single root `.env` file (docker compose loads
# it automatically). This template documents every value the stack uses.
# Simplest path: run `powershell -ExecutionPolicy Bypass -File scripts/try-windows.ps1 -Seed`
# which generates a complete local .env with random secrets and free ports.
# NEVER commit `.env` to version control.

# --- Runtime ---
NODE_ENV=production
APP_VERSION=1.0.0
# CI/deployment should inject the immutable source commit SHA.
APP_COMMIT_SHA=
# The production Compose stack requires Redis, MinIO, and all durable workers.
REDIS_REQUIRED=true
OBJECT_STORAGE_REQUIRED=true
WORKERS_REQUIRED=true
# Must be false over plain LAN HTTP; set true behind an HTTPS tunnel.
COOKIE_SECURE=false

# --- PostgreSQL (DB name/password are yours to choose — keep them consistent) ---
POSTGRES_USER=postgres
# Generate a strong local value. Keep it equal to DB_PASSWORD below.
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=vision_erp
POSTGRES_PORT=5432

# Host-side scripts (npm run migrate / seed / dev) read these directly.
# Keep them equal to the POSTGRES_* values above for the local Compose stack.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vision_erp
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
# Production Compose overrides these with a dedicated NOSUPERUSER/NOBYPASSRLS
# runtime role and a separate migration operator role. Never use postgres as the
# production runtime DB_USER.
# DB_USER=clinic_app
# DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
# DB_MIGRATION_USER=clinic_migrator
# DB_MIGRATION_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
# True only for managed Postgres that requires SSL (e.g. Neon/Railway).
DB_SSL=false

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
REDIS_PORT=6379

# --- JWT Authentication ---
# Generate with: openssl rand -hex 32
# These MUST be different from each other.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_openssl_rand_hex_32
CSRF_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# --- URLs / CORS ---
# Phone URL on the LAN, e.g. http://192.168.1.20 (or with the frontend port).
CORS_ORIGIN=http://localhost
APP_URL=http://localhost

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Host port mapping (optional; defaults shown) ---
BACKEND_PORT=3000
FRONTEND_PORT=80
VITE_API_URL=/api/v1

# --- Sentry (optional) ---
SENTRY_DSN=
